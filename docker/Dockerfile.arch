FROM archlinux:latest AS build

# `pacman -Sy` alone is a partial upgrade: libcurl.so.4 arrives from the
# repository while ngtcp2 stays old, and every pacman call then dies with
# "undefined symbol: ngtcp2_conn_get_tls_early_data_rejected2".
RUN yes | pacman -Syu --needed \
    base-devel \
    ca-certificates \
    curl \
    pkgconf \
    && yes | pacman -Scc

WORKDIR /src
COPY . .
RUN make -j"$(nproc)"

FROM archlinux:latest

RUN yes | pacman -Syu --needed \
    ca-certificates \
    curl \
    && yes | pacman -Scc

WORKDIR /workspace
COPY --from=build /src/warp /usr/local/bin/warp

ENTRYPOINT ["/usr/local/bin/warp"]
CMD ["--help"]
